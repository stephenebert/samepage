# Local development only. Copy to .env and keep that file untracked.
# Production: add MODEL_API_KEY in Site settings > Environment variables,
# enable Secret, and redeploy. Never paste a real key into this example.
MODEL_API_KEY=
# Optional; the standard Meta model is used by default.
SAMEPAGE_MODEL=muse-spark-1.3
# Studio live calls stay off until credit use is explicitly authorized.
# Configure both this switch and the secret server-side, then redeploy.
# Simulated reviews do not need either setting and never contact Meta.
SAMEPAGE_STUDIO_META_ENABLED=false
