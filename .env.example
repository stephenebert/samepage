# Local development only. Copy to .env and keep that file untracked.
# Production: add MODEL_API_KEY in Site settings > Environment variables,
# enable Secret, and redeploy. Never paste a real key into this example.
MODEL_API_KEY=
# Optional; the standard Meta model is used by default.
SAMEPAGE_MODEL=muse-spark-1.3
# Studio live calls stay off until credit use is explicitly authorized.
# Configure both this switch and the secret server-side, then redeploy.
# Simulated reviews do not need either setting and never contact Meta.
SAMEPAGE_STUDIO_META_ENABLED=false
# Compact responses preserve source text server-side. full-v1 is retained only
# for explicitly authorized matched evaluation of the previous request shape.
SAMEPAGE_STUDIO_PROTOCOL=compact-v2
# Medium remains the default. Low is a server-only evaluation setting; it needs
# independent quality validation before being used for a live demonstration.
SAMEPAGE_STUDIO_REASONING_EFFORT=medium
# Reuse exactly one unchanged, validated real medium interpretation in this
# room. This does not cache across rooms or avoid review of changed wording.
SAMEPAGE_STUDIO_REUSE_UNCHANGED=false

# Server-only output headroom: 8192 (default) or 12288; includes reasoning.
# Increase only after a length stop is confirmed; never retry automatically.
SAMEPAGE_STUDIO_OUTPUT_TOKENS=8192
# expression-v3 is an opt-in bounded-expression interpretation protocol.
