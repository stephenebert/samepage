# Copy this file to .dev.vars for local Wrangler development.
# Keep real credentials only in .dev.vars or your deployment secret manager.
MODEL_API_KEY=
SAMEPAGE_JUDGE_META_ENABLED=false
# Optional downward overrides of the server-side request limits.
SAMEPAGE_JUDGE_SESSION_CALLS=10
SAMEPAGE_JUDGE_MAX_CALLS=30
